{
  "name": "ai-memory",
  "version": "0.2.0",
  "description": "Personal, persistent, self-learning memory for AI coding assistants",
  "type": "module",
  "license": "MIT",
  "author": "Lior Hai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liorhai5/ai-memory.git"
  },
  "homepage": "https://github.com/liorhai5/ai-memory#readme",
  "bugs": {
    "url": "https://github.com/liorhai5/ai-memory/issues"
  },
  "keywords": [
    "ai",
    "memory",
    "llm",
    "cursor",
    "claude-code",
    "mcp",
    "cli",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ai-memory": "dist/cli.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "build": "npm run clean && tsc -p tsconfig.json && chmod +x dist/cli.js",
    "build:dashboard": "cd src/dashboard/client && npm run build",
    "build:all": "npm run build && npm run build:dashboard",
    "prepack": "npm run build:all",
    "test": "vitest run",
    "lint": "echo 'no linter configured for TS yet'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "better-sqlite3": "^11.10.0",
    "commander": "^14.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.21",
    "playwright": "^1.58.2",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
